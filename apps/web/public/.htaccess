DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical Redirect: Force non-www (e.g. www.klyroworks.com -> klyroworks.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Force HTTPS (supports direct SSL and CDN/proxy headers)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. Allow RFC 5785 .well-known directory (e.g. MCP Server Card at /.well-known/mcp/server-card.json)
  RewriteRule ^\.well-known/ - [L]

  # 4. Block access to other hidden files and directories (.git, .env, .htaccess, etc.)
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule (?:^|/)\. - [F,L]

  # 5. Block access to private directories, backend source code, and data
  RewriteRule ^(data|apps|scripts|node_modules|build|\.git)(/.*)?$ - [F,L,NC]

  # 6. Exceptions for public manifest and MCP server card JSON
  RewriteRule ^assets/manifest\.json$ - [L]
  RewriteRule ^\.well-known/mcp/server-card\.json$ - [L]
  RewriteRule ^__manifest$ assets/manifest.json [L,T=application/json]

  # 7. Block sensitive file types/extensions (protect configs, backups, logs, package files)
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{REQUEST_URI} !^/assets/manifest\.json$ [NC]
  RewriteRule \.(json|log|env|lock|md|ts|tsx|mjs|cjs|sql|sh|template|yml|yaml|bak|backup|config)$ - [F,L,NC]

  # 8. Content Negotiation: Serve Markdown when AI agents request Accept: text/markdown or text/x-markdown
  RewriteCond %{HTTP:Accept} (?:text/markdown|text/x-markdown) [NC]
  RewriteCond %{DOCUMENT_ROOT}/llms.txt -f
  RewriteRule ^(.*)$ /llms.txt [L,T=text/markdown;charset=UTF-8]

  # 9. Route /api/consultation to native PHP handler
  RewriteRule ^api/consultation/?$ api/consultation.php [L]

  # 10. Don't rewrite real files
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 11. Serve pre-rendered static route HTML files directly if they exist
  # Matches /services/seo or /services/seo/ and maps to services/seo/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 12. Don't rewrite real directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 13. Return 404 for missing static assets
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|json|map)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # 14. Real 404 for any non-existent page/route (Ensures AI agents receive real HTTP 404 instead of 200)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

# Custom 404 Error Document
ErrorDocument 404 /404.html

# Disable directory browsing
Options -Indexes

# Security headers, Link headers & cache control
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"

  # RFC 8288 Link headers advertising llms.txt, MCP Server Card, and sitemap on HTML pages
  <FilesMatch "(index\.html|404\.html)?$">
    Header set Link '</llms.txt>; rel="alternate"; type="text/markdown", </.well-known/mcp/server-card.json>; rel="service-desc"; type="application/json", </sitemap.xml>; rel="sitemap"; type="application/xml"'
  </FilesMatch>

  # Explicit Content-Type and CORS for llms.txt (Markdown)
  <Files "llms.txt">
    ForceType text/markdown; charset=utf-8
    Header set Content-Type "text/markdown; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </Files>

  # Explicit Content-Type and CORS for MCP Server Card
  <Files "server-card.json">
    ForceType application/json; charset=utf-8
    Header set Content-Type "application/json; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </Files>

  # Ensure index.html, __manifest, and server-card.json are revalidated
  <FilesMatch "(index\.html|__manifest|manifest\.json|server-card\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache immutable assets with hashes
  <FilesMatch "\.(js|css|webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
