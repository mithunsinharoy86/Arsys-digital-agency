DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical Redirect: Force non-www (e.g. www.klyroworks.com -> klyroworks.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Force HTTPS (supports direct SSL and CDN/proxy headers)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. Block access to hidden files and directories (.git, .env, .htaccess, etc.)
  RewriteRule (?:^|/)\. - [F,L]

  # 4. Block access to private directories, backend source code, and data
  RewriteRule ^(data|apps|scripts|node_modules|build|\.git)(/.*)?$ - [F,L,NC]

  # 5. Manifest exceptions (must remain readable for React Router)
  RewriteRule ^assets/manifest\.json$ - [L]
  RewriteRule ^__manifest$ assets/manifest.json [L,T=application/json]

  # 6. Block sensitive file types/extensions (protect configs, backups, logs, package files)
  RewriteRule \.(json|log|env|lock|md|ts|tsx|mjs|cjs|sql|sh|template|yml|yaml|bak|backup|config)$ - [F,L,NC]

  # Route /api/consultation to native PHP handler
  RewriteRule ^api/consultation/?$ api/consultation.php [L]

  # Don't rewrite real files
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve pre-rendered static route HTML files directly if they exist
  # Matches /services/seo or /services/seo/ and maps to services/seo/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # Don't rewrite real directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Return 404 for missing static assets instead of serving index.html
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|json|map)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # SPA Fallback for client routing
  RewriteRule . /index.html [L]
</IfModule>

ErrorDocument 404 /404.html


# Disable directory browsing
Options -Indexes

# Security headers & cache control
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"

  # Ensure index.html and __manifest are never cached indefinitely by browsers
  <FilesMatch "(index\.html|__manifest|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache immutable assets with hashes
  <FilesMatch "\.(js|css|webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
